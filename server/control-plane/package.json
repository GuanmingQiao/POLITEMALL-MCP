{
  "name": "@qiaoguanming/politemall-mcp",
  "version": "0.1.0",
  "description": "MCP server for the POLITEMall and NYP D2L Brightspace learning systems. Runs on your computer and signs in in your own browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GuanmingQiao/POLITEMALL-MCP.git",
    "directory": "server/control-plane"
  },
  "homepage": "https://github.com/GuanmingQiao/POLITEMALL-MCP#readme",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "brightspace",
    "d2l",
    "politemall",
    "nyp"
  ],
  "type": "module",
  "bin": {
    "politemall-mcp": "dist/local/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "tsc -p tsconfig.test.json && node --test \".test-build/tests/**/*.test.js\"",
    "smoke": "node scripts/smoke-pack.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.685.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.1",
    "node-html-parser": "^6.1.13",
    "playwright-core": "^1.64.1",
    "turndown": "^7.2.4",
    "unpdf": "^1.8.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.2"
  }
}
